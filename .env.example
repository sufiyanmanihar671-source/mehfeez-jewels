# Copy to .env for local development. These values are PUBLIC by design
# (the anon key is protected by Row Level Security). Never add the
# Supabase service_role key to this project, .env, Cloudflare or GitHub.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
PUBLIC_SITE_URL=https://www.example.com
# Set to "true" only if your Supabase plan includes Image Transformations.
PUBLIC_SUPABASE_IMAGE_TRANSFORM=false
# Set to "true" once the Google provider is enabled in Supabase.
PUBLIC_GOOGLE_LOGIN=false
